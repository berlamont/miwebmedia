<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
	    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.Spinner" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.StockChart" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.InPlaceEditor" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="29.1.35" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="29.1.35" />
  </ItemGroup>

</Project>
